# All VITE_* values are public browser config. Never put secrets here.
# Leave API_BASE_URL empty in development: the Vite proxy forwards /api to http://localhost:8000.
# In production set it to the Render API origin.
VITE_API_BASE_URL=
# Supabase > Project Settings > API. Format: https://<project-ref>.supabase.co  (a web address, NOT a folder path)
VITE_SUPABASE_URL=
# Supabase "publishable" (or legacy "anon") key. Never the service_role key.
VITE_SUPABASE_PUBLISHABLE_KEY=
# The map is Leaflet + OpenStreetMap: no map key and no map ID are needed.
