# All VITE_* values are public browser config. Never put secrets here.
# Leave empty in development: the Vite proxy forwards /api to http://localhost:8000.
# In production set it to the Render API origin.
VITE_API_BASE_URL=
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
