# Loaded from backend/.env; deployment environment variables take precedence.
# Supply real credentials only in a local ignored .env or deployment settings.
APP_ENV=development
# Explicit local-only fictional buildings for chat testing; forbidden in production.
DEMO_DATA_ENABLED=false
# Comma-separated exact origins, without trailing slashes or wildcards.
ALLOWED_ORIGINS=http://localhost:5173
# Integration credentials are optional for the process health endpoint.
# PostgreSQL URL (direct or Supabase pooler). Enables live building reads;
# schema migrations and seed import remain separate. Never put this in VITE_*.
# Example local URL: postgresql://postgres@127.0.0.1:55439/postgres
DATABASE_URL=
SUPABASE_URL=
# Auth uses the project's ES256/RS256 public signing keys; no shared JWT secret.
SUPABASE_SERVICE_ROLE_KEY=
AI_API_KEY=
AI_MODEL=deepseek-flash
AI_TIMEOUT_SECONDS=15
AI_MAX_OUTPUT_TOKENS=600
# Demo-only single-process limits; restarts reset these, not a dollar spending cap.
CHAT_REQUESTS_PER_MINUTE=5
CHAT_REQUESTS_PER_DAY=100
